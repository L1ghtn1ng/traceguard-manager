# Copy to .env and load it with your process manager. Never commit real values.

# Required. At least 32 characters; signs session and CSRF cookies.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
TGM_SECRET_KEY=

# sqlite+aiosqlite:///./traceguard-manager.db  or  postgresql+asyncpg://user:password@host/dbname
TGM_DATABASE_URL=sqlite+aiosqlite:///./traceguard-manager.db

# Hostnames the manager answers to (comma separated). Requests for other hosts are rejected.
TGM_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to the public origin when TLS ends at a proxy and the app itself sees plain HTTP,
# for example https://manager.example.com
TGM_CSRF_TRUSTED_ORIGINS=

# Keep true in production. Set false only for local plain-HTTP development.
TGM_SECURE_COOKIES=true

TGM_LOG_FORMAT=json
TGM_LOG_LEVEL=INFO

# Optional tuning (defaults shown)
# TGM_SESSION_IDLE_SECONDS=1800
# TGM_SESSION_ABSOLUTE_SECONDS=43200
# TGM_AGENT_OFFLINE_SECONDS=900
# TGM_LOGIN_MAX_FAILURES=5
# TGM_LOGIN_LOCKOUT_SECONDS=900
# TGM_LOGIN_REQUESTS_PER_MINUTE=10
# TGM_INGEST_MAX_RECORDS=500
# TGM_INGEST_REQUESTS_PER_MINUTE=240
# TGM_ALERT_RETENTION_DAYS=90

# Notifications (all optional)
# Public address of the dashboard, used for links in notifications.
# TGM_PUBLIC_URL=https://manager.example.com
# Webhooks are only sent to public https addresses unless this is true.
# TGM_NOTIFY_ALLOW_PRIVATE_NETWORKS=false
# Needed for email channels. TGM_SMTP_TLS is starttls (default), implicit or none.
# TGM_SMTP_HOST=smtp.example.com
# TGM_SMTP_PORT=587
# TGM_SMTP_USERNAME=
# TGM_SMTP_PASSWORD=
# TGM_SMTP_FROM=traceguard@example.com
# TGM_SMTP_TLS=starttls
